<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>¡Feliz Cumpleaños Melvin!</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background: #120c1f; /* Fondo morado oscuro */
      font-family: 'Courier New', Courier, monospace;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
      padding: 20px 0;
    }

    .container {
      perspective: 1500px;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      margin-top: 30px;
    }

    /* TARJETA PLEGABLE */
    .card-book {
      width: 380px;
      height: 520px;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 1s ease-in-out, width 0.8s ease-in-out;
      cursor: pointer;
    }

    .card-book.open {
      width: 760px;
      cursor: default;
    }

    .page {
      position: absolute;
      width: 380px;
      height: 520px;
      top: 0;
      background-size: cover;
      background-position: center;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      overflow: hidden;
    }

    /* COVER PAGE */
    .page-cover {
      left: 0;
      z-index: 5;
      transform-origin: left center;
      transition: transform 1s ease-in-out;
      border: 4px solid #3d2352;
    }

    .card-book.open .page-cover {
      transform: rotateY(-180deg);
      pointer-events: none;
    }

    /* INNER LEFT PAGE (Carta/Sobre) */
    .page-left {
      left: 0;
      background-color: #2b1836;
      display: flex;
      justify-content: center;
      align-items: center;
      border: 4px solid #3d2352;
      border-right: 2px solid #1c0e24;
    }

    /* INNER RIGHT PAGE (Velas/Pastel) */
    .page-right {
      left: 380px;
      background-color: #2b1836;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      border: 4px solid #3d2352;
      border-left: 2px solid #1c0e24;
      opacity: 0;
      transition: opacity 0.5s ease-in-out 0.3s;
    }

    .card-book.open .page-right {
      opacity: 1;
    }

    /* CONTENEDOR DE LA CARTA Y SOBRE */
    .envelope-wrapper {
      position: relative;
      width: 320px;
      height: 440px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .envelope-img {
      width: 100%;
      height: auto;
      position: absolute;
      z-index: 2;
    }

    .letter-img {
      width: 85%;
      height: auto;
      position: absolute;
      top: 40px;
      z-index: 1;
      transition: all 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }

    .letter-img.extracted {
      transform: translateY(-80px) scale(1.15);
      z-index: 10;
      box-shadow: 0 15px 30px rgba(0,0,0,0.6);
    }

    /* SECCIÓN PASTEL Y VELAS */
    .cake-wrapper {
      position: relative;
      width: 320px;
      height: 400px;
    }

    .cake-img {
      width: 100%;
      height: auto;
    }

    .flame {
      position: absolute;
      width: 35px;
      height: 50px;
      background-size: contain;
      background-repeat: no-repeat;
      transition: transform 0.1s ease, opacity 0.4s ease;
      transform-origin: bottom center;
    }

    .flame-1 {
      top: 75px;
      left: 135px;
    }

    .flame-2 {
      top: 90px;
      left: 195px;
    }

    .flame.blowing {
      transform: rotate(25deg) skewX(15deg) scaleY(0.8);
    }

    .flame.off {
      opacity: 0;
      transform: scale(0);
    }

    /* CONTROLES Y MEDIDOR */
    .mic-controls {
      margin-top: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 5px;
      color: #fff;
      font-size: 12px;
    }

    .meter-bar {
      width: 150px;
      height: 10px;
      background: rgba(255,255,255,0.2);
      border-radius: 5px;
      overflow: hidden;
      border: 1px solid #fff;
    }

    .meter-fill {
      width: 0%;
      height: 100%;
      background: #a855f7;
      transition: width 0.1s ease;
    }

    /* BOTONES */
    .btn {
      background: #5b21b6;
      color: #fff;
      border: 2px solid #3b0764;
      padding: 8px 16px;
      font-family: inherit;
      font-weight: bold;
      border-radius: 4px;
      cursor: pointer;
      box-shadow: 2px 2px 0px #000;
      margin-top: 15px;
      transition: all 0.2s;
    }

    .btn:hover {
      background: #6d28d9;
      transform: translateY(-2px);
    }

    .btn:active {
      transform: translateY(0);
    }

    /* MENSAJE DE DESEO Y CONFETI */
    .wish-message {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0);
      background: rgba(30, 16, 48, 0.95);
      border: 3px dashed #a855f7;
      color: #fff;
      padding: 20px;
      text-align: center;
      border-radius: 10px;
      z-index: 20;
      transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      box-shadow: 0 10px 30px rgba(0,0,0,0.7);
    }

    .wish-message.show {
      transform: translate(-50%, -50%) scale(1);
    }

    .wish-message h2 {
      color: #d8b4fe;
      margin-bottom: 10px;
    }

    canvas#confetti {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 99;
    }
  </style>
</head>
<body>

  <button class="btn" id="closeBtn" style="display: none; margin-bottom: 15px;">← Volver a la portada</button>

  <div class="container">
    <div class="card-book" id="cardBook">
      
      <!-- PORTADA -->
      <div class="page page-cover" id="pageCover">
        <div style="width: 100%; height: 100%; background-image: url('data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=='); background-size: cover;" id="coverImgHolder"></div>
      </div>

      <!-- INTERIOR IZQUIERDA (CARTA) -->
      <div class="page page-left">
        <div class="envelope-wrapper">
          <img class="envelope-img" id="envelopeImg" alt="Sobre" />
          <img class="letter-img" id="letterImg" alt="Carta" />
        </div>
      </div>

      <!-- INTERIOR DERECHA (VELAS) -->
      <div class="page page-right">
        <div class="cake-wrapper">
          <img class="cake-img" id="cakeImg" alt="Pastel" />
          <div class="flame flame-1" id="flame1"></div>
          <div class="flame flame-2" id="flame2"></div>
        </div>

        <div class="mic-controls">
          <span>Sopla al micrófono o mantén presionado:</span>
          <div class="meter-bar"><div class="meter-fill" id="meterFill"></div></div>
          <button class="btn" id="blowBtn">Soplar aquí (Sostener)</button>
        </div>

        <div class="wish-message" id="wishMessage">
          <h2>¡Pide un deseo, Melvin! ✨</h2>
          <p>Que todos tus proyectos y metas se cumplan este año.</p>
          <button class="btn" id="resetCandlesBtn">Volver a encender</button>
        </div>
      </div>

    </div>
  </div>

  <canvas id="confetti"></canvas>

  <script>
    // IMÁGENES ASOCIADAS
    const images = {
      cover: "input_file_0.png",
      envelope: "input_file_1.png",
      letter: "input_file_2.png",
      cake: "input_file_3.png"
    };

    // Asignar fuentes
    document.getElementById('envelopeImg').src = images.envelope;
    document.getElementById('letterImg').src = images.letter;
    document.getElementById('cakeImg').src = images.cake;
    document.getElementById('pageCover').style.backgroundImage = `url(${images.cover})`;

    // Elementos DOM
    const cardBook = document.getElementById('cardBook');
    const closeBtn = document.getElementById('closeBtn');
    const letterImg = document.getElementById('letterImg');
    const flame1 = document.getElementById('flame1');
    const flame2 = document.getElementById('flame2');
    const meterFill = document.getElementById('meterFill');
    const blowBtn = document.getElementById('blowBtn');
    const wishMessage = document.getElementById('wishMessage');
    const resetCandlesBtn = document.getElementById('resetCandlesBtn');

    let candlesLit = true;
    let blowTimer = null;
    let blowProgress = 0;

    // ABRIR / CERRAR TARJETA
    cardBook.addEventListener('click', (e) => {
      if (!cardBook.classList.contains('open')) {
        cardBook.classList.add('open');
        closeBtn.style.display = 'block';
        initMic();
      }
    });

    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      cardBook.classList.remove('open');
      closeBtn.style.display = 'none';
      letterImg.classList.remove('extracted');
    });

    // INTERACCIÓN CARTA
    letterImg.addEventListener('click', (e) => {
      e.stopPropagation();
      letterImg.classList.toggle('extracted');
    });

    // DETECCIÓN DE SOPLADO POR MICRÓFONO (WEB AUDIO API)
    let audioContext, analyser, microphone, stream;

    async function initMic() {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        analyser = audioContext.createAnalyser();
        microphone = audioContext.createMediaStreamSource(stream);
        microphone.connect(analyser);
        analyser.fftSize = 256;
        
        const dataArray = new Uint8Array(analyser.frequencyBinCount);
        
        function checkVolume() {
          if (!candlesLit) return;
          analyser.getByteFrequencyData(dataArray);
          let sum = 0;
          for (let i = 0; i < dataArray.length; i++) {
            sum += dataArray[i];
          }
          let average = sum / dataArray.length;
          
          if (average > 40) { // Umbral de soplo
            registerBlowing(true, average * 1.5);
          } else if (!isManualBlowing) {
            registerBlowing(false, 0);
          }
          requestAnimationFrame(checkVolume);
        }
        checkVolume();
      } catch (err) {
        console.log("Micrófono no disponible o bloqueado (requiere HTTPS). Usando opción manual.");
      }
    }

    // REGISTRO DE SOPLADO
    let isManualBlowing = false;

    function registerBlowing(isBlowing, intensity) {
      if (!candlesLit) return;

      if (isBlowing) {
        flame1.classList.add('blowing');
        flame2.classList.add('blowing');
        blowProgress += 4;
        meterFill.style.width = Math.min(100, blowProgress) + '%';

        if (blowProgress >= 100) {
          extinguishCandles();
        }
      } else {
        flame1.classList.remove('blowing');
        flame2.classList.remove('blowing');
        blowProgress = Math.max(0, blowProgress - 2);
        meterFill.style.width = blowProgress + '%';
      }
    }

    function extinguishCandles() {
      candlesLit = false;
      flame1.classList.remove('blowing');
      flame2.classList.remove('blowing');
      flame1.classList.add('off');
      flame2.classList.add('off');
      meterFill.style.width = '100%';
      
      setTimeout(() => {
        wishMessage.classList.add('show');
        launchConfetti();
      }, 500);
    }

    // SOPLADO MANUAL (BOTÓN Y ESPACIO)
    function startManualBlow() {
      isManualBlowing = true;
      blowTimer = setInterval(() => {
        registerBlowing(true, 80);
      }, 50);
    }

    function stopManualBlow() {
      isManualBlowing = false;
      clearInterval(blowTimer);
      registerBlowing(false, 0);
    }

    blowBtn.addEventListener('mousedown', startManualBlow);
    blowBtn.addEventListener('mouseup', stopManualBlow);
    blowBtn.addEventListener('mouseleave', stopManualBlow);
    blowBtn.addEventListener('touchstart', (e) => { e.preventDefault(); startManualBlow(); });
    blowBtn.addEventListener('touchend', stopManualBlow);

    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && !e.repeat && candlesLit) {
        startManualBlow();
      }
    });

    window.addEventListener('keyup', (e) => {
      if (e.code === 'Space') {
        stopManualBlow();
      }
    });

    // REINICIAR VELAS
    resetCandlesBtn.addEventListener('click', () => {
      candlesLit = true;
      flame1.classList.remove('off');
      flame2.classList.remove('off');
      wishMessage.classList.remove('show');
      blowProgress = 0;
      meterFill.style.width = '0%';
    });

    // EFECTO CONFETI AMBIENTAL
    function launchConfetti() {
      const canvas = document.getElementById('confetti');
      const ctx = canvas.getContext('2d');
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const pieces = [];
      const colors = ['#a855f7', '#c084fc', '#e91e63', '#3f51b5', '#00bcd4', '#ffeb3b', '#ff9800'];

      for (let i = 0; i < 100; i++) {
        pieces.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height - canvas.height,
          size: Math.random() * 10 + 5,
          color: colors[Math.floor(Math.random() * colors.length)],
          speed: Math.random() * 3 + 2,
          rotation: Math.random() * 360
        });
      }

      function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        pieces.forEach((p) => {
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate((p.rotation * Math.PI) / 180);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
          ctx.restore();

          p.y += p.speed;
          p.rotation += 2;

          if (p.y > canvas.height) p.y = -10;
        });

        if (!candlesLit) requestAnimationFrame(draw);
      }
      draw();
    }
  </script>
</body>
</html>
